<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
        Allow cleartext HTTP to the Spring Boot backend.
        10.0.2.2 = Android emulator alias for the host machine's localhost.
        Change the IP below if testing on a physical device.
    -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <!-- Physical device: add your machine's LAN IP here -->
        <!-- <domain includeSubdomains="false">192.168.1.100</domain> -->
    </domain-config>
</network-security-config>
